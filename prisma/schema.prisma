// Every table that holds workspace data carries team_id and is protected by
// Postgres row-level security (see the init migration). Always query through
// withTenant() in src/server/db.ts so the policy has a workspace to filter on.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  employee
  multi_channel_guest
  single_channel_guest
  slack_connect
  contractor
  external
  bot
}

model Workspace {
  teamId               String    @id @map("team_id")
  enterpriseId         String?   @map("enterprise_id")
  isEnterpriseInstall  Boolean   @default(false) @map("is_enterprise_install")
  name                 String?
  domain               String?
  // Full Bolt installation object, AES-256-GCM encrypted (it holds the bot token).
  installation         String
  managerFieldId       String?   @map("manager_field_id")
  departmentFieldId    String?   @map("department_field_id")
  plan                 String?
  allowGuestViewers    Boolean   @default(false) @map("allow_guest_viewers")
  // Slack owners and admins count as org chart admins (off by default).
  autoAdminSlackAdmins Boolean   @default(false) @map("auto_admin_slack_admins")
  // Profile link field: the link field to fill, and the admin whose user
  // token (encrypted) writes it.
  profileLinkFieldId   String?   @map("profile_link_field_id")
  profileWriterId      String?   @map("profile_writer_id")
  profileWriterToken   String?   @map("profile_writer_token")
  installedBy          String?   @map("installed_by")
  installedAt          DateTime  @default(now()) @map("installed_at")
  uninstalledAt        DateTime? @map("uninstalled_at")
  deleteAfter          DateTime? @map("delete_after")

  @@index([enterpriseId])
  @@map("workspace")
}

model Person {
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @map("team_id")
  slackUserId    String   @map("slack_user_id")
  // The user's home team. Differs from team_id for Slack Connect people.
  homeTeamId     String?  @map("home_team_id")
  name           String
  displayName    String?  @map("display_name")
  title          String?
  department     String?
  email          String?
  avatarUrl      String?  @map("avatar_url")
  userType       UserType @map("user_type")
  externalOrg    String?  @map("external_org")
  slackManagerId String?  @map("slack_manager_id")
  isSlackAdmin   Boolean  @default(false) @map("is_slack_admin")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at")

  override PersonOverride?

  @@unique([teamId, slackUserId])
  @@map("person")
}

model PersonOverride {
  personId       String    @id @map("person_id") @db.Uuid
  teamId         String    @map("team_id")
  managerSlackId String?   @map("manager_slack_id")
  userType       UserType? @map("user_type")
  externalOrg    String?   @map("external_org")
  title          String?
  department     String?
  hidden         Boolean?
  sortOrder      Int?      @map("sort_order")
  updatedBy      String    @map("updated_by")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("person_override")
}

model UserSession {
  id          String   @id // sha256 of the cookie value
  teamId      String   @map("team_id")
  slackUserId String   @map("slack_user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([teamId, slackUserId])
  @@map("user_session")
}

model AdminRole {
  teamId      String   @map("team_id")
  slackUserId String   @map("slack_user_id")
  role        String   @default("admin")
  grantedBy   String?  @map("granted_by")
  grantedAt   DateTime @default(now()) @map("granted_at")

  @@id([teamId, slackUserId])
  @@map("admin_role")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  teamId   String   @map("team_id")
  actor    String
  action   String
  personId String?  @map("person_id") @db.Uuid
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([teamId, at])
  @@index([teamId, personId])
  @@map("audit_log")
}

model SyncRun {
  id         BigInt    @id @default(autoincrement())
  teamId     String    @map("team_id")
  kind       String
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  counts     Json?
  errors     Json?

  @@index([teamId, startedAt])
  @@map("sync_run")
}

// A person's own user token for group DMs and channels, encrypted.
model UserGrant {
  teamId      String   @map("team_id")
  slackUserId String   @map("slack_user_id")
  // The workspace the token belongs to. Differs from team_id on Grid.
  slackTeamId String   @map("slack_team_id")
  token       String
  scopes      String
  grantedAt   DateTime @default(now()) @map("granted_at")

  @@id([teamId, slackUserId])
  @@map("user_grant")
}

// What the app last wrote to each person's profile link field.
model ProfileLink {
  teamId      String   @map("team_id")
  slackUserId String   @map("slack_user_id")
  fieldId     String   @map("field_id")
  value       String
  writtenAt   DateTime @default(now()) @map("written_at")

  @@id([teamId, slackUserId])
  @@map("profile_link")
}
