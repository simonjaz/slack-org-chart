NODE_ENV=development
PORT=3000
# Public https URL of this service. Slack must be able to reach it.
BASE_URL=https://orgchart.example.com
DATABASE_URL=postgresql://orgchart:orgchart@localhost:5432/orgchart
# From the Slack app's Basic Information page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Any random string of 16+ characters.
SLACK_STATE_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
NIGHTLY_SYNC_HOUR_UTC=2
